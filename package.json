{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/run-all.ts",
    "test:unit": "node --experimental-strip-types tests/test-stage-a.ts && node --experimental-strip-types tests/test-fixture.ts",
    "cek-ai": "node --experimental-strip-types --env-file-if-exists=.env tests/cek-ai.ts"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.76.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
