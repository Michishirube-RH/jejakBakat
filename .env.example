# JejakBakat AI Environment Configuration
# Salin file ini menjadi .env lalu isi dengan API key yang kamu miliki:
# cp .env.example .env

# --- Opsi 1: Google Gemini (Direkomendasikan) ---
# Dapatkan key di: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Opsi 2: OpenAI / Groq / OpenRouter / DeepSeek ---
# OPENAI_API_KEY=your_openai_or_groq_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Port server (opsional, default 8443)
# PORT=8443

